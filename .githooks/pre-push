#!/bin/sh
#
# pre-push hook: block the push when Qlty finds new issues, or when the
# CodeRabbit CLI reports findings at or above the gate severity, in the
# commits that are being pushed. No pull request is required.
#
# Enable it in a clone with:
#   git config core.hooksPath .githooks
#
# Install the Qlty CLI once:
#   curl https://qlty.sh | sh
#
# Install the CodeRabbit CLI once, then sign in:
#   brew install coderabbit
#   coderabbit auth login
#   # or: curl -fsSL https://cli.coderabbit.ai/install.sh | sh
#
# This is a guardrail, not a guarantee: `git push --no-verify` bypasses it.
# The hook stays out of the way when a CLI is not installed or CodeRabbit
# is not authenticated, so a clone without that tool can still push.
#

DEFAULT_BASE_BRANCH=master
CODERABBIT_GATE_SEVERITY=major
ZERO_OID=0000000000000000000000000000000000000000

# Git passes the refs that are being pushed on stdin.
input=$(cat)

if ! command -v qlty >/dev/null 2>&1; then
    echo "pre-push: qlty is not installed, skipping the quality check."
    echo "pre-push: install it with: curl https://qlty.sh | sh"
elif [ ! -f .qlty/qlty.toml ]; then
    echo "pre-push: .qlty/qlty.toml is missing, skipping the quality check."
else
    # Qlty prints a stray upgrade-check line ("Tap enter to skip...") whenever
    # stdin is not a terminal, which is always true here. Capture the output so
    # the exit code is kept and that one line can be dropped.
    report=$(mktemp) || exit 1
    printf '%s\n' "$input" | qlty check \
        --trigger pre-push \
        --upstream-from-pre-push \
        --no-formatters \
        --skip-errored-plugins \
        --no-upgrade-check > "$report" 2>&1
    status=$?
    grep -v '^Tap enter to skip\.\.\.$' "$report" || true
    rm -f "$report"

    if [ "$status" -ne 0 ]; then
        echo
        echo "pre-push: push blocked by the Qlty quality check."
        echo "pre-push: fix the issues above, or bypass once with: git push --no-verify"
        exit 1
    fi
fi

resolve_coderabbit_cli() {
    if command -v coderabbit >/dev/null 2>&1; then
        printf '%s\n' coderabbit
        return 0
    fi
    if command -v cr >/dev/null 2>&1; then
        printf '%s\n' cr
        return 0
    fi
    return 1
}

if ! coderabbit_cli=$(resolve_coderabbit_cli); then
    echo "pre-push: CodeRabbit CLI is not installed, skipping the review."
    echo "pre-push: install it with: brew install coderabbit"
    echo "pre-push: or: curl -fsSL https://cli.coderabbit.ai/install.sh | sh"
    exit 0
fi

if ! "$coderabbit_cli" auth status >/dev/null 2>&1; then
    echo "pre-push: CodeRabbit CLI is not authenticated, skipping the review."
    echo "pre-push: sign in with: coderabbit auth login"
    exit 0
fi

# Review each non-delete ref being pushed. Prefer the remote tip as the base
# commit so only new commits are reviewed. New branches compare to master.
while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_ref" ] || continue
    [ "$local_sha" != "$ZERO_OID" ] || continue

    echo "pre-push: running CodeRabbit review for $local_ref..."

    if [ -n "$remote_sha" ] && [ "$remote_sha" != "$ZERO_OID" ]; then
        "$coderabbit_cli" review \
            --committed \
            --base-commit "$remote_sha" \
            --gate "$CODERABBIT_GATE_SEVERITY"
        status=$?
    else
        "$coderabbit_cli" review \
            --committed \
            --base "$DEFAULT_BASE_BRANCH" \
            --gate "$CODERABBIT_GATE_SEVERITY"
        status=$?
    fi

    if [ "$status" -eq 2 ]; then
        echo
        echo "pre-push: push blocked by CodeRabbit findings at or above $CODERABBIT_GATE_SEVERITY."
        echo "pre-push: fix the findings above, or bypass once with: git push --no-verify"
        exit 1
    fi

    if [ "$status" -ne 0 ]; then
        echo
        echo "pre-push: push blocked because the CodeRabbit review did not finish."
        echo "pre-push: fix the problem above, or bypass once with: git push --no-verify"
        exit 1
    fi
done <<EOF
$input
EOF

exit 0
